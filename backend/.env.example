# Copy to backend/.env and fill in. Every key is optional: missing keys switch that service to its offline fallback.

# --- LLM (Grok via xAI) ---
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Speech (Sarvam AI) ---
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh

# --- WhatsApp Cloud API (test number) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# --- App ---
DEMO_PIN=1234
DATABASE_URL=sqlite:///./vyapar.db
# Demo date (YYYY-MM-DD). Empty = today.
DEMO_DATE=
# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_SCHEDULER=true
