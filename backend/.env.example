# Copy to backend/.env and fill in. Every key is optional: a missing key switches that service to its offline fallback.

# --- LLM (Groq preferred; xAI Grok used only if GROQ_API_KEY is empty) ---
# Groq keys start with gsk_ (console.groq.com). Tool-capable models: openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Speech (Sarvam AI) ---
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh

# --- App ---
DEMO_PIN=1234
# DATABASE_URL defaults to backend/vyapar.db; set only to use another database
# DATABASE_URL=
# Demo date (YYYY-MM-DD). Empty = today.
DEMO_DATE=
# Optional: exact time the demo clock starts at after reset (ISO, IST), e.g. 2026-11-15T08:30:00
DEMO_NOW=
# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Background jobs: morning briefing + reminder scheduler, and forecast warm-up at startup
ENABLE_SCHEDULER=true
