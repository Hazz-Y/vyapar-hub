# Copy to backend/.env and fill in. Every key is optional: missing keys switch that service to its offline fallback.

# --- LLM (Grok via xAI) ---
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Speech (Sarvam AI) ---
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh

# --- WhatsApp Cloud API (test number) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# --- App ---
DEMO_PIN=1234
# DATABASE_URL defaults to backend/vyapar.db; set only to use another database
# DATABASE_URL=
# Demo date (YYYY-MM-DD). Empty = today.
DEMO_DATE=
# Optional: exact time the demo clock starts at after reset (ISO, IST), e.g. 2026-11-15T08:30:00
DEMO_NOW=
# Optional: the allowlisted demo phone (E.164, e.g. +919812345678). Used as Sunita ji's number.
DEMO_CUSTOMER_PHONE=
# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_SCHEDULER=true
